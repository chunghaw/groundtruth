{
  "vars": {
    "REA_EASY_URL": "REPLACE_ME https://www.realestate.com.au/property-...",
    "DOMAIN_UNIT_URL": "REPLACE_ME https://www.domain.com.au/...",
    "DOMAIN_SWITCH_LINK": "REPLACE_ME a[href*='<second listing id>']",
    "REA_BUILDING_URL": "REPLACE_ME https://www.realestate.com.au/property-unit-...",
    "REA_OOA_URL": "REPLACE_ME https://www.realestate.com.au/property-house-nsw-parramatta-..."
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "deviceScaleFactor": 1.5,
  "extension": true,
  "blockers": [
    "#onetrust-banner-sdk",
    "#onetrust-consent-sdk .ot-sdk-container",
    "[aria-label*='cookie' i][role='dialog']",
    "[class*='CookieBanner']"
  ],
  "init": [
    {
      "do": "goto",
      "url": "{{REA_EASY_URL}}"
    },
    {
      "do": "waitPanel",
      "selector": ".pill.EXACT",
      "timeout": 30000
    }
  ],
  "beats": {
    "d01-rea-open": {
      "setup": [
        {
          "do": "goto",
          "url": "about:blank"
        }
      ],
      "show": [
        {
          "do": "goto",
          "url": "{{REA_EASY_URL}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 25000
        }
      ]
    },
    "d02-receipt": {
      "crop": "1280:720:640:90",
      "setup": [
        {
          "do": "waitPanel",
          "selector": "section[aria-label='Agency quoting accuracy']",
          "timeout": 25000
        },
        {
          "do": "scrollPanelTo",
          "selector": "section.receipt"
        }
      ],
      "show": [
        {
          "do": "clickPanel",
          "selector": "section.receipt:not(.open) .strip",
          "optional": true,
          "timeout": 400
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt dl dd:nth-of-type(1)"
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt dl dd:nth-of-type(2)",
          "at": 3
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt dl dd:nth-of-type(3)",
          "at": 5
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt dl dd:nth-of-type(4)",
          "at": 7
        },
        {
          "do": "hoverPanel",
          "selector": "button.link",
          "at": 10.5
        }
      ]
    },
    "d03-facts": {
      "crop": "1280:720:640:90",
      "setup": [],
      "show": [
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Agency quoting accuracy']"
        },
        {
          "do": "hoverPanel",
          "selector": "section[aria-label='Agency quoting accuracy'] .big"
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Microburbs value']",
          "at": 7.5
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Last sales']",
          "at": 9.5,
          "optional": true
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Street vs suburb']",
          "at": 11,
          "optional": true
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Risk overlays']",
          "at": 12.5,
          "optional": true
        }
      ]
    },
    "d04-offer": {
      "crop": "1280:720:640:90",
      "setup": [
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Realistic budget'], section[aria-label='Microburbs value']"
        }
      ],
      "show": [
        {
          "do": "typePanel",
          "selector": "#gt-guide, input[aria-label='Guide price you were quoted']",
          "text": "$1.1m",
          "at": 1.0
        },
        {
          "do": "waitPanel",
          "selector": ".offer-pill, .guide-verdict.below, .guide-verdict.above, .guide-verdict.inside"
        },
        {
          "do": "hoverPanel",
          "selector": ".offer-pill, .guide-verdict.below, .guide-verdict.above, .guide-verdict.inside"
        }
      ]
    },
    "d05-domain-unit": {
      "setup": [
        {
          "do": "goto",
          "url": "about:blank"
        }
      ],
      "show": [
        {
          "do": "goto",
          "url": "{{DOMAIN_UNIT_URL}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 25000
        },
        {
          "do": "scrollPanelTo",
          "selector": "section.receipt"
        },
        {
          "do": "clickPanel",
          "selector": "section.receipt:not(.open) .strip",
          "optional": true,
          "timeout": 400
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt dl dd:nth-of-type(2)"
        }
      ]
    },
    "d06-spa-switch": {
      "setup": [],
      "show": [
        {
          "do": "clickPage",
          "selector": "{{DOMAIN_SWITCH_LINK}}",
          "at": 1.0
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT, .pill.BUILDING, .pill.CHOOSE",
          "timeout": 25000
        },
        {
          "do": "clickPanel",
          "selector": "section.receipt:not(.open) .strip",
          "optional": true,
          "timeout": 400
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt dl dd:nth-of-type(1)"
        }
      ]
    },
    "d07-hidden-unit": {
      "setup": [
        {
          "do": "goto",
          "url": "{{REA_BUILDING_URL}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.BUILDING",
          "timeout": 25000
        }
      ],
      "show": [
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Narrow down the unit']"
        },
        {
          "do": "clickPanel",
          "selector": ".beds button:nth-child(2)",
          "at": 7.5
        },
        {
          "do": "waitPanel",
          "selector": ".beds button[aria-pressed='true']"
        },
        {
          "do": "hoverPanel",
          "selector": "ul.units li:first-child button",
          "at": 10.5
        }
      ]
    },
    "d08-out-of-area": {
      "setup": [
        {
          "do": "goto",
          "url": "about:blank"
        }
      ],
      "show": [
        {
          "do": "goto",
          "url": "{{REA_OOA_URL}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.OUT_OF_AREA",
          "timeout": 25000
        }
      ]
    },
    "d09-next-door": {
      "setup": [
        {
          "do": "goto",
          "url": "{{REA_EASY_URL}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 25000
        }
      ],
      "show": [
        {
          "do": "clickPanel",
          "selector": "[data-gt='next-door-3d-open']",
          "optional": true,
          "timeout": 4000
        },
        {
          "do": "waitPanel",
          "selector": "[data-gt='next-door-3d']",
          "optional": true,
          "timeout": 4000
        }
      ]
    },
    "d10-briefing": {
      "setup": [],
      "show": [
        {
          "do": "clickPanel",
          "selector": "button.brief-btn, [data-gt='briefing-play']",
          "optional": true,
          "timeout": 4000
        },
        {
          "do": "waitPanel",
          "selector": ".brief-cap span.now",
          "optional": true,
          "timeout": 6000
        }
      ]
    },
    "d13-close": {
      "setup": [
        {
          "do": "scrollPanelTo",
          "selector": "section.receipt"
        }
      ],
      "show": [
        {
          "do": "mouseTo",
          "value": "500,400"
        }
      ]
    }
  }
}