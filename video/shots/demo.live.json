{
  "vars": {
    "REA_UNIT_URL": "https://www.realestate.com.au/property-apartment-nsw-surry+hills-152864656",
    "DOMAIN_URL": "https://www.domain.com.au/405-82-92-cooper-street-surry-hills-nsw-2010-2021297146",
    "DOMAIN_SWITCH_LINK": "a[href*='2021233955']",
    "REA_BUILDING_URL": "https://www.realestate.com.au/property-apartment-nsw-sydney-152411876",
    "REA_BONDI_URL": "https://www.realestate.com.au/property-apartment-nsw-bondi-152714008"
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "deviceScaleFactor": 1.5,
  "extension": true,
  "blockers": [
    "#onetrust-banner-sdk",
    "[aria-label*='cookie' i][role='dialog']",
    "[class*='CookieBanner']"
  ],
  "init": [
    {
      "do": "goto",
      "url": "{{REA_UNIT_URL}}"
    },
    {
      "do": "waitPanel",
      "selector": ".pill.EXACT",
      "timeout": 30000
    }
  ],
  "beats": {
    "d01-rea-unit": {
      "setup": [
        {
          "do": "goto",
          "url": "about:blank"
        }
      ],
      "show": [
        {
          "do": "goto",
          "url": "{{REA_UNIT_URL}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 30000
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt button.strip"
        }
      ]
    },
    "d02-receipt": {
      "crop": "1280:720:640:90",
      "show": [
        {
          "do": "clickPanel",
          "selector": "section.receipt button.strip",
          "at": 0.5
        },
        {
          "do": "waitPanel",
          "selector": "section.receipt.open"
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(1)",
          "at": 2.5
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(3)",
          "at": 4.5
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(4)",
          "at": 6.5
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd.checks",
          "at": 8.5,
          "optional": true
        }
      ]
    },
    "d03-next-door": {
      "show": [
        {
          "do": "scrollPanelTo",
          "selector": "section.card.c3",
          "block": "start",
          "at": 0.3
        },
        {
          "do": "waitPanel",
          "selector": "section.card.c3 .c3-legend .c3-ramp",
          "timeout": 15000,
          "optional": true
        },
        {
          "do": "hoverPanel",
          "selector": "section.card.c3 .c3-stage",
          "at": 3.3,
          "optional": true
        },
        {
          "do": "hoverPanel",
          "selector": "section.card.c3 .c3-stage",
          "at": 9.3,
          "optional": true
        }
      ]
    },
    "d04-facts": {
      "show": [
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Risk overlays']",
          "block": "center",
          "at": 0.3,
          "optional": true
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Strata levy (suburb median)']",
          "block": "center",
          "at": 4,
          "optional": true
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Microburbs value']",
          "block": "center",
          "at": 7,
          "optional": true
        }
      ]
    },
    "d05-listing-switch": {
      "setup": [
        {
          "do": "goto",
          "url": "{{DOMAIN_URL}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT, .pill.BUILDING",
          "timeout": 30000
        }
      ],
      "show": [
        {
          "do": "hoverPanel",
          "selector": "section.receipt button.strip",
          "at": 0.5
        },
        {
          "do": "clickPage",
          "selector": "{{DOMAIN_SWITCH_LINK}}",
          "at": 3.5
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT, .pill.BUILDING, .pill.CHOOSE",
          "timeout": 25000
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt button.strip"
        }
      ]
    },
    "d06-hidden-unit": {
      "setup": [
        {
          "do": "goto",
          "url": "{{REA_BUILDING_URL}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.BUILDING",
          "timeout": 30000
        }
      ],
      "show": [
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Narrow down the unit']",
          "block": "center"
        },
        {
          "do": "clickPanel",
          "selector": ".beds button:nth-child(2)",
          "at": 7.5
        },
        {
          "do": "waitPanel",
          "selector": ".beds button[aria-pressed='true']"
        },
        {
          "do": "hoverPanel",
          "selector": "ul.units li:first-child button",
          "at": 10.0,
          "optional": true
        }
      ]
    },
    "d07-out-of-area": {
      "setup": [
        {
          "do": "goto",
          "url": "about:blank"
        }
      ],
      "show": [
        {
          "do": "goto",
          "url": "{{REA_BONDI_URL}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.OUT_OF_AREA",
          "timeout": 30000
        }
      ]
    },
    "d08-briefing": {
      "setup": [
        {
          "do": "goto",
          "url": "{{REA_UNIT_URL}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 30000
        }
      ],
      "show": [
        {
          "do": "clickPanel",
          "selector": "button.brief-btn",
          "at": 1.0,
          "optional": true
        },
        {
          "do": "waitPanel",
          "selector": ".brief-cap span.now",
          "optional": true,
          "timeout": 8000
        }
      ]
    },
    "d11-close": {
      "setup": [
        {
          "do": "scrollPanelTo",
          "selector": "section.receipt button.strip",
          "block": "start"
        }
      ],
      "show": [
        {
          "do": "mouseTo",
          "value": "500,400"
        }
      ]
    }
  }
}