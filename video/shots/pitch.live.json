{
  "vars": {
    "REA_UNIT_URL": "https://www.realestate.com.au/property-apartment-nsw-surry+hills-152864656"
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "deviceScaleFactor": 1.5,
  "extension": true,
  "blockers": [
    "#onetrust-banner-sdk",
    "[aria-label*='cookie' i][role='dialog']",
    "[class*='CookieBanner']"
  ],
  "init": [
    {
      "do": "goto",
      "url": "{{REA_UNIT_URL}}"
    },
    {
      "do": "waitPanel",
      "selector": ".pill.EXACT",
      "timeout": 30000
    }
  ],
  "beats": {
    "p1-hook": {
      "setup": [
        {
          "do": "goto",
          "url": "{{REA_UNIT_URL}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 30000
        }
      ],
      "show": [
        {
          "do": "hoverPanel",
          "selector": "section.receipt button.strip",
          "at": 1.5
        }
      ]
    },
    "p2-receipt": {
      "crop": "1280:720:640:90",
      "show": [
        {
          "do": "clickPanel",
          "selector": "section.receipt button.strip",
          "at": 0.3
        },
        {
          "do": "waitPanel",
          "selector": "section.receipt.open"
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(1)",
          "at": 2.3
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(3)",
          "at": 4.3
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(4)",
          "at": 6.3
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd.checks",
          "at": 8.3,
          "optional": true
        }
      ]
    },
    "p3-next-door": {
      "show": [
        {
          "do": "scrollPanelTo",
          "selector": "section.card.c3",
          "block": "start",
          "at": 0.3
        },
        {
          "do": "waitPanel",
          "selector": "section.card.c3 .c3-legend .c3-ramp",
          "timeout": 15000,
          "optional": true
        },
        {
          "do": "hoverPanel",
          "selector": "section.card.c3 .c3-stage",
          "at": 3.3,
          "optional": true
        },
        {
          "do": "hoverPanel",
          "selector": "section.card.c3 .c3-stage",
          "at": 9.3,
          "optional": true
        }
      ]
    },
    "p5-close": {
      "setup": [
        {
          "do": "scrollPanelTo",
          "selector": "section.receipt button.strip",
          "block": "start"
        }
      ],
      "show": [
        {
          "do": "mouseTo",
          "value": "500,400"
        }
      ]
    }
  }
}