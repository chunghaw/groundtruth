{
  "vars": {
    "DEMO": "https://groundtruth-tawny-one.vercel.app/demo",
    "P_BUILDING": "building"
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "deviceScaleFactor": 1.5,
  "extension": false,
  "blockers": [],
  "init": [
    {
      "do": "goto",
      "url": "{{DEMO}}"
    },
    {
      "do": "waitPanel",
      "selector": ".pill.EXACT",
      "timeout": 30000
    }
  ],
  "beats": {
    "x1-receipt": {
      "show": [
        {
          "do": "clickPanel",
          "selector": "section.receipt button.strip",
          "at": 0.3
        },
        {
          "do": "waitPanel",
          "selector": "section.receipt.open"
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(4)"
        }
      ]
    },
    "x2-building": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        },
        {
          "do": "selectPage",
          "selector": ".demo-controls select",
          "value": "{{P_BUILDING}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.BUILDING",
          "timeout": 30000
        }
      ],
      "show": [
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Narrow down the unit']",
          "block": "center"
        },
        {
          "do": "clickPanel",
          "selector": ".beds button:nth-child(2)"
        },
        {
          "do": "waitPanel",
          "selector": ".beds button[aria-pressed='true']"
        }
      ]
    }
  }
}