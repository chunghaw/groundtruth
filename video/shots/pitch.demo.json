{
  "vars": {
    "DEMO": "https://groundtruth-tawny-one.vercel.app/demo",
    "P_UNIT": "live-exact-unit",
    "P_HOUSE": "live-exact-house",
    "P_BUILDING": "live-building",
    "P_OOA": "live-out-of-area",
    "_old_mock_ids": "exact-unit / exact-house / building / out-of-area"
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "deviceScaleFactor": 1.5,
  "extension": false,
  "blockers": [],
  "init": [
    {
      "do": "goto",
      "url": "{{DEMO}}"
    },
    {
      "do": "waitPanel",
      "selector": ".pill.EXACT",
      "timeout": 30000
    }
  ],
  "beats": {
    "p1-hook": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        },
        {
          "do": "selectPage",
          "selector": ".demo-controls select",
          "value": "{{P_HOUSE}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 30000
        }
      ],
      "show": [
        {
          "do": "hoverPanel",
          "selector": "section.receipt button.strip",
          "at": 1.5
        }
      ]
    },
    "p2-receipt": {
      "show": [
        {
          "do": "clickPanel",
          "selector": "section.receipt button.strip",
          "at": 0.3
        },
        {
          "do": "waitPanel",
          "selector": "section.receipt.open"
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(1)",
          "at": 2.3
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(3)",
          "at": 4.3
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(4)",
          "at": 6.3
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd.checks",
          "at": 8.3,
          "optional": true
        }
      ]
    },
    "p3-next-door": {
      "show": [
        {
          "do": "scrollPanelTo",
          "selector": "section.card.c3",
          "block": "start",
          "at": 0.3
        },
        {
          "do": "waitPanel",
          "selector": "section.card.c3 .c3-lead",
          "timeout": 20000,
          "optional": true
        },
        {
          "do": "hoverPanel",
          "selector": "section.card.c3 .c3-stage",
          "at": 3.3,
          "optional": true
        },
        {
          "do": "clickPanel",
          "selector": "section.card.c3 .c3-segs button.c3-seg",
          "at": 7.3,
          "optional": true
        },
        {
          "do": "hoverPanel",
          "selector": "section.card.c3 .c3-stage",
          "at": 9.3,
          "optional": true
        }
      ]
    },
    "p5-close": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        }
      ],
      "show": [
        {
          "do": "mouseTo",
          "value": "500,400"
        }
      ]
    }
  }
}