{
  "vars": {
    "DEMO": "https://groundtruth-tawny-one.vercel.app/demo",
    "P_UNIT": "live-exact-unit",
    "P_HOUSE": "live-exact-house",
    "P_BUILDING": "live-building",
    "P_OOA": "live-out-of-area",
    "_old_mock_ids": "exact-unit / exact-house / building / out-of-area"
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "deviceScaleFactor": 1.5,
  "extension": false,
  "blockers": [],
  "init": [
    {
      "do": "goto",
      "url": "{{DEMO}}"
    },
    {
      "do": "waitPanel",
      "selector": ".pill.EXACT",
      "timeout": 30000
    }
  ],
  "beats": {
    "d01-rea-unit": {
      "setup": [
        {
          "do": "goto",
          "url": "about:blank"
        }
      ],
      "show": [
        {
          "do": "goto",
          "url": "{{DEMO}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 30000
        },
        {
          "do": "scrollPage",
          "y": 0
        },
        {
          "do": "selectPage",
          "selector": ".demo-controls select",
          "value": "{{P_UNIT}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 30000
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt button.strip"
        }
      ]
    },
    "d02-receipt": {
      "show": [
        {
          "do": "clickPanel",
          "selector": "section.receipt button.strip",
          "at": 0.5
        },
        {
          "do": "waitPanel",
          "selector": "section.receipt.open"
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(1)",
          "at": 2.5
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(3)",
          "at": 4.5
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd:nth-of-type(4)",
          "at": 6.5
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt .rbody dd.checks",
          "at": 8.5,
          "optional": true
        }
      ]
    },
    "d03-next-door": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        },
        {
          "do": "selectPage",
          "selector": ".demo-controls select",
          "value": "{{P_HOUSE}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 30000
        }
      ],
      "show": [
        {
          "do": "scrollPanelTo",
          "selector": "section.card.c3",
          "block": "start",
          "at": 0.3
        },
        {
          "do": "waitPanel",
          "selector": "section.card.c3 .c3-lead",
          "timeout": 20000,
          "optional": true
        },
        {
          "do": "hoverPanel",
          "selector": "section.card.c3 .c3-stage",
          "at": 3.3,
          "optional": true
        },
        {
          "do": "clickPanel",
          "selector": "section.card.c3 .c3-segs button.c3-seg",
          "at": 7.3,
          "optional": true
        },
        {
          "do": "hoverPanel",
          "selector": "section.card.c3 .c3-stage",
          "at": 9.3,
          "optional": true
        }
      ]
    },
    "d04-facts": {
      "show": [
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Risk overlays']",
          "block": "center",
          "at": 0.3,
          "optional": true
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Strata levy (suburb median)']",
          "block": "center",
          "at": 4,
          "optional": true
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Microburbs value']",
          "block": "center",
          "at": 7,
          "optional": true
        }
      ]
    },
    "d05-domain-switch": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        }
      ],
      "show": [
        {
          "do": "clickPage",
          "selector": "button[title^='Swap the listing']",
          "at": 1.0
        },
        {
          "do": "waitPage",
          "selector": ".demo-log li:has-text('dropped')",
          "timeout": 15000
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt button.strip"
        }
      ]
    },
    "d06-hidden-unit": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        },
        {
          "do": "selectPage",
          "selector": ".demo-controls select",
          "value": "{{P_BUILDING}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.BUILDING",
          "timeout": 30000
        }
      ],
      "show": [
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Narrow down the unit']",
          "block": "center"
        },
        {
          "do": "clickPanel",
          "selector": ".beds button:nth-child(2)",
          "at": 7.5
        },
        {
          "do": "waitPanel",
          "selector": ".beds button[aria-pressed='true']"
        },
        {
          "do": "hoverPanel",
          "selector": "ul.units li:first-child button",
          "at": 10.0,
          "optional": true
        }
      ]
    },
    "d07-out-of-area": {
      "show": [
        {
          "do": "scrollPage",
          "y": 0
        },
        {
          "do": "selectPage",
          "selector": ".demo-controls select",
          "value": "{{P_OOA}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.OUT_OF_AREA",
          "timeout": 30000
        }
      ]
    },
    "d08-briefing": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        },
        {
          "do": "selectPage",
          "selector": ".demo-controls select",
          "value": "{{P_HOUSE}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 30000
        }
      ],
      "show": [
        {
          "do": "clickPanel",
          "selector": "button.brief-btn",
          "at": 1.0,
          "optional": true
        },
        {
          "do": "waitPanel",
          "selector": ".brief-cap span.now",
          "optional": true,
          "timeout": 8000
        }
      ]
    },
    "d11-close": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        }
      ],
      "show": [
        {
          "do": "mouseTo",
          "value": "500,400"
        }
      ]
    }
  }
}