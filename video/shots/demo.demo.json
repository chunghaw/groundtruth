{
  "vars": {
    "DEMO": "https://groundtruth-tawny-one.vercel.app/demo"
  },
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "deviceScaleFactor": 1.5,
  "extension": false,
  "blockers": [],
  "init": [
    {
      "do": "goto",
      "url": "{{DEMO}}"
    },
    {
      "do": "waitPanel",
      "selector": ".pill.EXACT",
      "timeout": 30000
    }
  ],
  "beats": {
    "d01-rea-open": {
      "setup": [
        {
          "do": "goto",
          "url": "about:blank"
        }
      ],
      "show": [
        {
          "do": "goto",
          "url": "{{DEMO}}"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 30000
        }
      ]
    },
    "d02-receipt": {
      "setup": [
        {
          "do": "scrollPanelTo",
          "selector": "section.receipt",
          "block": "center"
        }
      ],
      "show": [
        {
          "do": "hoverPanel",
          "selector": "section.receipt dl dd:nth-of-type(1)"
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt dl dd:nth-of-type(2)",
          "at": 3
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt dl dd:nth-of-type(3)",
          "at": 5
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt dl dd:nth-of-type(4)",
          "at": 7
        },
        {
          "do": "hoverPanel",
          "selector": "button.link",
          "at": 10.5
        }
      ]
    },
    "d03-facts": {
      "setup": [],
      "show": [
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Agency quoting accuracy']",
          "block": "center"
        },
        {
          "do": "hoverPanel",
          "selector": "section[aria-label='Agency quoting accuracy'] .big"
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Microburbs value']",
          "block": "center",
          "at": 7.5
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Last sales']",
          "block": "center",
          "at": 9.5,
          "optional": true
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Street vs suburb']",
          "block": "center",
          "at": 11,
          "optional": true
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Risk overlays']",
          "block": "center",
          "at": 12.5,
          "optional": true
        }
      ]
    },
    "d04-offer": {
      "setup": [
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Realistic budget'], section[aria-label='Microburbs value']",
          "block": "center"
        }
      ],
      "show": [
        {
          "do": "typePanel",
          "selector": "#gt-guide, input[aria-label='Guide price you were quoted']",
          "text": "$1.1m",
          "at": 1.0
        },
        {
          "do": "waitPanel",
          "selector": ".offer-pill, .guide-verdict.below, .guide-verdict.above, .guide-verdict.inside"
        },
        {
          "do": "hoverPanel",
          "selector": ".offer-pill, .guide-verdict.below, .guide-verdict.above, .guide-verdict.inside"
        }
      ]
    },
    "d05-domain-unit": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        }
      ],
      "show": [
        {
          "do": "selectPage",
          "selector": ".demo-controls select",
          "value": "exact-house"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 20000
        },
        {
          "do": "scrollPanelTo",
          "selector": "section.receipt",
          "block": "center"
        },
        {
          "do": "hoverPanel",
          "selector": "section.receipt dl dd:nth-of-type(4)"
        }
      ]
    },
    "d06-spa-switch": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        }
      ],
      "show": [
        {
          "do": "clickPage",
          "selector": "button[title^='Swap the listing']",
          "at": 1.0
        },
        {
          "do": "waitPage",
          "selector": ".demo-log li:has-text('dropped')",
          "timeout": 15000
        },
        {
          "do": "hoverPage",
          "selector": ".demo-log",
          "optional": true
        }
      ]
    },
    "d07-hidden-unit": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        }
      ],
      "show": [
        {
          "do": "selectPage",
          "selector": ".demo-controls select",
          "value": "building"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.BUILDING",
          "timeout": 20000
        },
        {
          "do": "scrollPanelTo",
          "selector": "section[aria-label='Narrow down the unit']",
          "block": "center"
        },
        {
          "do": "clickPanel",
          "selector": ".beds button:nth-child(2)",
          "at": 7.5
        },
        {
          "do": "waitPanel",
          "selector": ".beds button[aria-pressed='true']"
        },
        {
          "do": "hoverPanel",
          "selector": "ul.units li:first-child button",
          "at": 10.5,
          "optional": true
        }
      ]
    },
    "d08-out-of-area": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        }
      ],
      "show": [
        {
          "do": "selectPage",
          "selector": ".demo-controls select",
          "value": "out-of-area"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.OUT_OF_AREA",
          "timeout": 20000
        }
      ]
    },
    "d09-next-door": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        }
      ],
      "show": [
        {
          "do": "selectPage",
          "selector": ".demo-controls select",
          "value": "exact-house"
        },
        {
          "do": "waitPanel",
          "selector": ".pill.EXACT",
          "timeout": 20000
        },
        {
          "do": "clickPanel",
          "selector": "[data-gt='next-door-3d-open']",
          "optional": true,
          "timeout": 4000
        },
        {
          "do": "waitPanel",
          "selector": "[data-gt='next-door-3d']",
          "optional": true,
          "timeout": 4000
        }
      ]
    },
    "d10-briefing": {
      "setup": [],
      "show": [
        {
          "do": "clickPanel",
          "selector": "button.brief-btn, [data-gt='briefing-play']",
          "optional": true,
          "timeout": 4000
        },
        {
          "do": "waitPanel",
          "selector": ".brief-cap span.now",
          "optional": true,
          "timeout": 6000
        }
      ]
    },
    "d13-close": {
      "setup": [
        {
          "do": "scrollPage",
          "y": 0
        }
      ],
      "show": [
        {
          "do": "mouseTo",
          "value": "500,400"
        }
      ]
    }
  }
}