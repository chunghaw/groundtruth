{
  "manifest_version": 3,
  "name": "Groundtruth",
  "description": "Microburbs facts beside a realestate.com.au or domain.com.au listing. Reads only the address.",
  "version": "0.1.0",
  "permissions": [],
  "host_permissions": [
    "https://www.realestate.com.au/*",
    "https://www.domain.com.au/*",
    "http://localhost:3000/*",
    "https://groundtruth-proxy.vercel.app/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.realestate.com.au/*", "https://www.domain.com.au/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Groundtruth", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
