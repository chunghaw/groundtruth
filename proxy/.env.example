# Microburbs Hackathon API key (from the 11:00 email). Server-side only.
MICROBURBS_API_KEY=
# Shared token the extension sends as X-Groundtruth-Client. Required in production.
GROUNDTRUTH_CLIENT_TOKEN=
# Path to the supplied addresses CSV (never commit it). Default: ../data/addresses-city-of-sydney.csv
ADDRESS_CSV_PATH=
# Optional JSON column mapping if auto-detect fails, e.g. {"gnaf":"ADDRESS_DETAIL_PID","unit":"FLAT_NUMBER","number":"NUMBER_FIRST","streetName":"STREET_NAME","streetType":"STREET_TYPE","suburb":"LOCALITY_NAME"}
ADDRESS_CSV_COLUMNS=
# 1 = deterministic fake data, no upstream calls. Also on automatically when MICROBURBS_API_KEY is empty.
MOCK=
# Optional: ElevenLabs voice for the 30-second briefing (server-side only, never sent to the client).
# Without a key, /api/briefing returns the script and the panel uses browser speech.
ELEVENLABS_API_KEY=
# Optional voice id; default JBFqnCBsd6RMkjVDRZzb (stock "George").
ELEVENLABS_VOICE_ID=
